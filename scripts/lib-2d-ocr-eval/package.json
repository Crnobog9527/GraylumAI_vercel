{
  "name": "lib-2d-ocr-eval",
  "private": true,
  "type": "module",
  "description": "LIB-2d step 1 browser OCR evaluation. Standalone: not part of the pnpm workspace, never installed by the repo.",
  "scripts": {
    "assets": "node fetch-assets.mjs",
    "build": "esbuild src/tess-worker.js --bundle --format=iife --platform=browser --minify --outfile=dist/tess-worker.js --external:fs --external:path --external:crypto --external:worker_threads --external:module --external:url --external:child_process && esbuild src/paddle-worker.js --bundle --format=iife --platform=browser --minify --outfile=dist/paddle-worker.js --alias:onnxruntime-web=./node_modules/onnxruntime-web/dist/ort.wasm.bundle.min.mjs",
    "gen": "node gen.mjs set && node gen.mjs set vocab",
    "score": "node rescore.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "onnxruntime-web": "1.30.0",
    "playwright": "1.64.0",
    "ppu-paddle-ocr": "6.6.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  }
}
