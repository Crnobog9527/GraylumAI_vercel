{
  // Standalone API type check (CI "Lint & Type Check"). Production code is fully
  // checked. Test files that already had type errors when this check was added
  // are excluded below as a shrinking baseline: remove a file once it passes,
  // and never add one. apps/web/tsconfig.json still checks the API files it lists.
  "extends": "../tsconfig/base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "paths": { "@/*": ["../../apps/web/src/*"] }
  },
  "include": ["src/**/*.ts", "vitest.config.ts", "vitest.integration.config.ts"],
  "exclude": [
    "node_modules",
    "src/routers/admin.test.ts",
    "src/routers/ai.test.ts",
    "src/routers/aiStreamAdmission.integration.ts",
    "src/routers/aiStreamRoute.test.ts",
    "src/routers/chat.test.ts",
    "src/routers/credits.test.ts",
    "src/routers/diagnostics.test.ts",
    "src/routers/model.test.ts",
    "src/routers/openRouterSearch.integration.ts",
    "src/routers/ordinaryChatReliability.integration.ts",
    "src/routers/payments.test.ts",
    "src/routers/searchEvidence.integration.ts",
    "src/routers/settings.test.ts",
    "src/routers/ticket.test.ts",
    "src/routers/user.test.ts",
    "src/services/__tests__/billing.security.test.ts",
    "src/services/__tests__/billing.test.ts",
    "src/services/__tests__/contentModerator.test.ts",
    "src/services/__tests__/costCalculator.test.ts",
    "src/services/__tests__/diagnostics.test.ts",
    "src/services/__tests__/invitationColumnGrants.integration.ts",
    "src/services/__tests__/invitationRuntime.test.ts",
    "src/services/__tests__/modelColumnGrants.integration.ts",
    "src/services/__tests__/refund1bConsumedAmount.test.ts",
    "src/services/__tests__/stripe.test.ts",
    "src/services/__tests__/stripeFulfillment.test.ts",
    "src/services/__tests__/stripeWebhookRoute.test.ts",
    "src/services/__tests__/subscriptionCreditGrants.test.ts",
    "src/services/__tests__/ticketAutoClose.test.ts",
    "src/services/__tests__/tokenCounter.test.ts",
    "src/services/__tests__/workbench.integration.ts",
    "src/services/opc/mentor-browser.integration.ts",
    "src/services/opc/opc.integration.ts",
    "src/services/runtime/runtime.integration.ts",
    "src/trpc.test.ts"
  ]
}
