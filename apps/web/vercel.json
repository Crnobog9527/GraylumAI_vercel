{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "staging": true,
      "claude/**": false,
      "codex/**": false,
      "dependabot/**": false,
      "feat/**": false,
      "fix/**": false,
      "perf/**": false,
      "docs/**": false,
      "chore/**": false,
      "assets/**": false,
      "spec/**": false,
      "test/**": false,
      "refactor/**": false,
      "drill/**": false,
      "backup/**": false,
      "hotfix/**": false,
      "release/**": false,
      "cache-*": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/tickets/auto-close",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/release-subscription-credits",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/ticket-attachments-cleanup",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/billing-reconcile",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/diagnostics",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/account-erasure",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/library-cleanup",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/fusion-recovery",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/social-monitor",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/runtime-recovery",
      "schedule": "* * * * *"
    }
  ]
}
