{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "codex/consumption-read-contract-20260910": false,
      "codex/search-evidence-metering-20260910": false,
      "staging": true,
      "codex/skill-search-consumption-20260910": false,
      "codex/chat-request-reliability-20260910": false,
      "codex/v3-chat-skill-20260908": false,
      "codex/v3-web-search-contract-20260908": false,
      "codex/admin-skill-publication-20260909": false,
      "codex/admin-management-repair-20260909": false,
      "codex/admin-delete-dialogs-20260909": false,
      "codex/model-usage-accuracy-20260909": false,
      "codex/skill-model-readiness-20260909": false,
      "codex/chat-balance-timeout-20260911": false,
      "codex/account-artifact-reuse-20260912": false
