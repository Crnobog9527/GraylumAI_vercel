{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/diagnostics",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/tickets/auto-close",
      "schedule": "0 0 * * *"
    }
  ]
}
