{
  "extends": "../../packages/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "../../packages/api/src/services/skills/**/*.ts", "../../packages/api/src/services/research/**/*.ts", "../../packages/api/src/services/__tests__/*Package*.ts", "../../packages/api/src/services/__tests__/*Research*.ts", "../../packages/api/src/services/__tests__/packagePublication.test.ts", "../../packages/api/vitest.integration.config.ts", "../../packages/db/schema.ts"],
  "exclude": ["node_modules"]
}
