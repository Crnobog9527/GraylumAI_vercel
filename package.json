{
  "name": "GraylumAI_vercel",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "audit:parity": "bash ./scripts/run-refactor-parity-audit.sh",
    "audit:parity:extended": "bash ./scripts/run-refactor-parity-audit.sh --with-extended",
    "audit:parity:user-supplemental": "bash ./scripts/run-refactor-parity-audit.sh --with-extended --with-user-extended --with-user-supplemental",
    "audit:parity:round1": "bash ./scripts/run-refactor-parity-audit.sh --with-extended --with-user-extended --with-user-supplemental",
    "audit:parity:round2": "bash ./scripts/run-refactor-parity-audit.sh --with-extended --with-user-extended --with-user-supplemental --with-admin-config",
    "audit:parity:round3": "bash ./scripts/run-refactor-parity-audit.sh --with-extended --with-user-extended --with-user-supplemental --with-admin-config --with-admin-ops",
    "audit:parity:destructive": "bash ./scripts/run-refactor-parity-audit.sh --with-extended --with-user-extended --with-user-supplemental --with-admin-config --with-admin-ops --with-admin-destructive",
    "audit:parity:full": "bash ./scripts/run-refactor-parity-audit.sh --with-security",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "pipeline:health": "node ./scripts/check-pipeline-health.mjs",
    "release:preflight": "bash ./scripts/run-release-preflight.sh",
    "release:preflight:preview": "bash ./scripts/run-release-preflight.sh --with-preview",
    "release:preflight:destructive": "bash ./scripts/run-release-preflight.sh --with-preview --with-admin-destructive",
    "stripe:readiness": "node ./scripts/check-stripe-readiness.mjs",
    "stripe:readiness:staging": "node ./scripts/check-stripe-readiness.mjs --env .env.staging.local --confirm-staging --require-test-mode",
    "test": "turbo test",
    "test:api": "pnpm --filter @repo/api test:run",
    "test:ci:auth-bootstrap": "pnpm --filter @repo/api exec vitest run src/trpc.test.ts",
    "test:ci:checkout-cancellation": "pnpm --filter @repo/api exec vitest run src/routers/settings.test.ts src/routers/payments.test.ts src/services/__tests__/membershipEligibility.test.ts src/services/__tests__/stripe.test.ts src/services/__tests__/stripeFulfillment.test.ts src/services/__tests__/subscriptionCreditGrants.test.ts src/services/__tests__/subscriptionPlanButtonState.test.ts",
    "test:ci:pay-1-frontend": "pnpm --filter web exec vitest run src/components/landing/PricingSection.test.tsx src/components/profile/SubscriptionCard.test.tsx --testNamePattern='^(?!.*(local mobile browser|local browser|actual upgrade preview)).*$'",
    "test:ci:skill-runtime": "pnpm --filter @repo/api exec vitest run src/services/__tests__/skillRuntime.test.ts",
    "test:ci:year-calendar": "pnpm --filter @repo/api exec vitest run src/services/__tests__/subscriptionCreditGrants.test.ts",
    "test:ci:refund-race": "pnpm --filter @repo/api exec vitest run src/services/__tests__/refund1bConsumedAmount.test.ts src/services/__tests__/subscriptionCreditGrants.test.ts",
    "test:ci:billing-cron": "pnpm --filter @repo/api exec vitest run src/services/__tests__/billingReconciliation.test.ts src/services/__tests__/billingReconciliationPermissions.test.ts && pnpm --filter web exec vitest run src/app/api/cron/billing-reconcile/route.test.ts",
    "test:ci:proxy-hostname": "pnpm --filter web exec vitest run src/proxy-hostname.test.ts",
    "test:ci:safeguards": "node --test scripts/tests/*.test.mjs",
    "db:push": "node scripts/db-push-guard.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24 <25"
  },
  "pnpm": {
    "overrides": {
      "@eslint/config-array>minimatch": "3.1.4",
      "@eslint/eslintrc>minimatch": "3.1.4",
      "@sentry/node>minimatch": "9.0.7",
      "ajv@8.17.1": "8.18.0",
      "brace-expansion@1.1.13": "1.1.18",
      "brace-expansion@5.0.4": "5.0.9",
      "flatted": "3.4.2",
      "fast-uri": "3.1.6",
      "nanoid": "3.3.18",
      "postcss": "8.5.18",
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "eslint>minimatch": "3.1.4",
      "glob>minimatch": "9.0.7",
      "next>postcss": "8.5.18",
      "picomatch@2.3.1": "2.3.2",
      "picomatch@4.0.3": "4.0.4",
      "sharp": "0.35.0",
      "terser-webpack-plugin>serialize-javascript": "7.0.3",
      "rollup": "4.59.0",
      "browserslist": "4.28.7"
    }
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "pg": "^8.20.0",
    "turbo": "^2.9.14"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.100.10",
    "@trpc/client": "^11.17.0",
    "@trpc/next": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.1",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "zod": "^4.3.6"
  }
}
