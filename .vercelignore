# .git stays: the Ignored Build Step (apps/web/scripts/vercel-ignore-build.mjs) reads the commits since the last deployment.
# Function bundles take only traced files, so .git never reaches a deployment.
.audit-output
.agent
.agents
.claude
.release-output
.turbo
.next
node_modules
apps/web/.next
apps/web/node_modules
apps/web/playwright-report
apps/web/test-results
output
