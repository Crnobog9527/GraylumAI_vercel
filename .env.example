# ============================================
# GraylumAI Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ============================================
# Supabase Configuration (Required)
# ============================================
# Get these from your Supabase project settings: https://supabase.com/dashboard

# Public Supabase URL - safe to expose to the client
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase anonymous key - safe to expose to the client
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service role key - KEEP SECRET, only use server-side
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# Database Configuration (Required for Drizzle)
# ============================================
# PostgreSQL connection URL from Supabase

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ============================================
# AI Provider Configuration (Required)
# ============================================
# Anthropic API key for Claude models
# Get from: https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-api03-...

# ============================================
# Redis Configuration (Optional - Recommended for Production)
# ============================================
# Used for distributed rate limiting and session storage
# If not provided, falls back to in-memory storage (not suitable for multi-instance deployments)

# Option 1: Redis URL (takes precedence if set)
# REDIS_URL=redis://username:password@host:port/db

# Option 2: Individual Redis settings
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# REDIS_DB=0

# ============================================
# Security Configuration (Optional)
# ============================================
# API request signing for sensitive operations

# Secret key for HMAC-SHA256 request signatures
# Generate with: openssl rand -hex 32
# API_SIGNATURE_SECRET=your-secret-key-here

# Set to 'true' to require signatures on all sensitive API calls
# REQUIRE_API_SIGNATURE=false

# ============================================
# Application Settings (Optional)
# ============================================

# Node environment
NODE_ENV=development

# Next.js specific
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Rate Limiting Configuration (Optional)
# ============================================
# These values have sensible defaults in the code
# Only override if needed

# AI request rate limit (requests per minute)
# RATE_LIMIT_AI_MAX_REQUESTS=60

# Stream request rate limit (requests per minute)
# RATE_LIMIT_AI_STREAM_MAX_REQUESTS=30

# ============================================
# Circuit Breaker Configuration (Optional)
# ============================================
# Consumption limits to prevent abuse

# Hourly credit consumption limit per user
# CIRCUIT_BREAKER_HOURLY_LIMIT=10000

# Daily credit consumption limit per user
# CIRCUIT_BREAKER_DAILY_LIMIT=50000
