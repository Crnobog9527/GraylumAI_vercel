# ============================================
# GraylumAI Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ============================================
# Supabase Configuration (Required)
# ============================================
# Get these from your Supabase project settings: https://supabase.com/dashboard

# Public Supabase URL - safe to expose to the client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase anonymous key - safe to expose to the client
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key

# Supabase service role key - KEEP SECRET, only use server-side
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Independent server-only HMAC keyring for opening-grant anti-abuse (DATA-ERASURE PR-E).
# Configuring real keys (staging or production) requires Owner approval (AGENTS.md section 1). Keep retained old versions.
# Canonical Base64 encoding of 32-64 bytes per independent key; never use test-only keys on Vercel.
# OPENING_GRANT_HMAC_KEYS={"active":"v1","keys":{"v1":"BASE64_ENCODED_INDEPENDENT_KEY"}}

# ============================================
# Database Configuration (Required for Drizzle)
# ============================================
# PostgreSQL connection URL from Supabase

DATABASE_URL=postgresql://postgres:your-password@your-project.pooler.supabase.com:6543/postgres

# ============================================
# AI Provider Configuration (Required)
# ============================================
# OpenRouter API key for Claude / OpenAI-compatible models
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Anthropic official API is retired for this project.
# Do not add ANTHROPIC_API_KEY; Claude models should use OpenRouter model IDs
# such as anthropic/claude-sonnet-4.6 with the OpenRouter chat/completions endpoint.

# ============================================
# Distributed Rate Limiting (Upstash Redis)
# ============================================
# Both credentials are required for distributed admission in every environment.
# Missing configuration, errors and timeouts reject requests; no memory fallback.
# RATE_LIMIT_FAIL_CLOSED is retired and cannot opt out of this behavior.
# Vercel builds reject missing/invalid credentials before compilation (no network probe).
# Local/secretless CI builds may omit them, but requests still fail closed.
# Offline tests must explicitly mock Redis; use a separate development Redis locally.
# All values below are placeholders; replace deliberately for the target environment.
# UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.example.invalid
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ============================================
# Security Configuration (Optional)
# ============================================
# 目前代码没有读取或没有生效：以下签名变量在辅助函数中被读取，
# 但 checkRequestSignature 未接入生产请求路径；仅配置变量不会启用签名校验。

# Secret key for HMAC-SHA256 request signatures
# Generate with: openssl rand -hex 32
# API_SIGNATURE_SECRET=your-secret-key-here

# Reserved signature requirement setting; not wired into production requests
# REQUIRE_API_SIGNATURE=false

# ============================================
# Sentry Error Monitoring (Recommended)
# ============================================
# Get these from your Sentry project settings: https://sentry.io/

# Sentry DSN for error tracking (public, safe for client)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Sentry organization and project (for source map upload)
# SENTRY_ORG=your-org-name
# SENTRY_PROJECT=your-project-name

# Sentry auth token for CI/CD (for source map upload)
# Get from: https://sentry.io/settings/auth-tokens/
# SENTRY_AUTH_TOKEN=sntrys_xxx

# Set to 'true' only when Sentry source map / release upload is configured correctly
# ENABLE_SENTRY_BUILD_UPLOAD=false

# ============================================
# Application Settings (Optional)
# ============================================

# Runtime / display metadata (placeholders, not production defaults)
# NEXT_PUBLIC_HCAPTCHA_SITEKEY=your-hcaptcha-sitekey
# NEXT_PUBLIC_SITE_NAME=your-site-name
# NEXT_PUBLIC_SUPPORT_EMAIL=your-support-address
# NEXT_PUBLIC_APP_NAME=your-app-name
# SENTRY_ENVIRONMENT=your-sentry-environment
# APP_ENV=your-app-environment
# NEXT_PUBLIC_APP_ENV=your-public-app-environment
# LOG_LEVEL=your-log-level
# V3_RUNTIME_STAGING_ENABLED=your-true-or-false
# V3_RUNTIME_STAGING_ENABLED is only one gate; it does not authorize provider calls
# or configure all staging identity/database/window checks. See runtime/stagingEnvironment.ts.

# Node environment
NODE_ENV=development

# Next.js specific
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_AUTH_APP_URL=http://localhost:3000

# Staging safety metadata for local readiness scripts.
# EXPECTED_APP_HOST=auth-staging.graylum.com
# EXPECTED_SUPABASE_PROJECT_REF=your-staging-project-ref

# Stripe hosted checkout (required when enabling real payments)
# STRIPE_SECRET_KEY=sk_test_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Cron route protection secret
# CRON_SECRET=generate-a-random-long-string

# ============================================
# Local E2E Audit Accounts (Optional)
# ============================================
# Used by Playwright critical-flow audits in apps/web/tests/e2e
# Provide dedicated local test users instead of personal accounts

# Standard user account for login, chat, and profile audits
# E2E_TEST_EMAIL=test-user@example.com
# E2E_TEST_PASSWORD=your-test-user-password

# Admin account for /admin smoke audits
# E2E_ADMIN_EMAIL=admin-user@example.com
# E2E_ADMIN_PASSWORD=your-admin-password

# ============================================
# Rate Limiting Configuration (Optional)
# ============================================
# 目前代码没有读取或没有生效：以下 RATE_LIMIT_AI_* 仅在 envValidator 中声明；
# 实际限流器使用代码内固定值，配置这些变量不会修改限额。

# AI request rate limit (requests per minute)
# RATE_LIMIT_AI_MAX_REQUESTS=60

# Stream request rate limit (requests per minute)
# RATE_LIMIT_AI_STREAM_MAX_REQUESTS=30

# ============================================
# Circuit Breaker Configuration (Optional)
# ============================================
# 目前代码没有读取或没有生效：以下 CIRCUIT_BREAKER_* 仅在 envValidator 中声明；
# securityChecks 使用固定阈值，配置这些变量不会修改阈值。

# Hourly credit consumption limit per user
# CIRCUIT_BREAKER_HOURLY_LIMIT=10000

# Daily credit consumption limit per user
# CIRCUIT_BREAKER_DAILY_LIMIT=50000
