# ============================================
# GraylumAI Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ============================================
# Supabase Configuration (Required)
# ============================================
# Get these from your Supabase project settings: https://supabase.com/dashboard

# Public Supabase URL - safe to expose to the client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase anonymous key - safe to expose to the client
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key

# Supabase service role key - KEEP SECRET, only use server-side
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================
# Database Configuration (Required for Drizzle)
# ============================================
# PostgreSQL connection URL from Supabase

DATABASE_URL=postgresql://postgres:your-password@your-project.pooler.supabase.com:6543/postgres

# ============================================
# AI Provider Configuration (Required)
# ============================================
# OpenRouter API key for Claude / OpenAI-compatible models
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Anthropic official API is retired for this project.
# Do not add ANTHROPIC_API_KEY; Claude models should use OpenRouter model IDs
# such as anthropic/claude-sonnet-4.6 with the OpenRouter chat/completions endpoint.

# ============================================
# Distributed Rate Limiting (Optional - For Multi-Instance Deployments)
# ============================================
# Current implementation uses in-memory storage (suitable for single-instance)
# For distributed deployments, consider:
# - Vercel KV: https://vercel.com/docs/storage/vercel-kv
# - Upstash Rate Limit: https://github.com/upstash/ratelimit
#
# Example Vercel KV configuration:
# KV_URL=your-vercel-kv-url
# KV_REST_API_URL=your-kv-rest-api-url
# KV_REST_API_TOKEN=your-kv-rest-api-token
# KV_REST_API_READ_ONLY_TOKEN=your-kv-read-only-token

# ============================================
# Security Configuration (Optional)
# ============================================
# API request signing for sensitive operations

# Secret key for HMAC-SHA256 request signatures
# Generate with: openssl rand -hex 32
# API_SIGNATURE_SECRET=your-secret-key-here

# Set to 'true' to require signatures on all sensitive API calls
# REQUIRE_API_SIGNATURE=false

# ============================================
# Sentry Error Monitoring (Recommended)
# ============================================
# Get these from your Sentry project settings: https://sentry.io/

# Sentry DSN for error tracking (public, safe for client)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Sentry organization and project (for source map upload)
# SENTRY_ORG=your-org-name
# SENTRY_PROJECT=your-project-name

# Sentry auth token for CI/CD (for source map upload)
# Get from: https://sentry.io/settings/auth-tokens/
# SENTRY_AUTH_TOKEN=sntrys_xxx

# Set to 'true' only when Sentry source map / release upload is configured correctly
# ENABLE_SENTRY_BUILD_UPLOAD=false

# ============================================
# Application Settings (Optional)
# ============================================

# Node environment
NODE_ENV=development

# Next.js specific
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe hosted checkout (required when enabling real payments)
# STRIPE_SECRET_KEY=sk_test_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Cron route protection secret
# CRON_SECRET=generate-a-random-long-string

# ============================================
# Local E2E Audit Accounts (Optional)
# ============================================
# Used by Playwright critical-flow audits in apps/web/tests/e2e
# Provide dedicated local test users instead of personal accounts

# Standard user account for login, chat, and profile audits
# E2E_TEST_EMAIL=test-user@example.com
# E2E_TEST_PASSWORD=your-test-user-password

# Admin account for /admin smoke audits
# E2E_ADMIN_EMAIL=admin-user@example.com
# E2E_ADMIN_PASSWORD=your-admin-password

# ============================================
# Rate Limiting Configuration (Optional)
# ============================================
# These values have sensible defaults in the code
# Only override if needed

# AI request rate limit (requests per minute)
# RATE_LIMIT_AI_MAX_REQUESTS=60

# Stream request rate limit (requests per minute)
# RATE_LIMIT_AI_STREAM_MAX_REQUESTS=30

# ============================================
# Circuit Breaker Configuration (Optional)
# ============================================
# Consumption limits to prevent abuse

# Hourly credit consumption limit per user
# CIRCUIT_BREAKER_HOURLY_LIMIT=10000

# Daily credit consumption limit per user
# CIRCUIT_BREAKER_DAILY_LIMIT=50000
